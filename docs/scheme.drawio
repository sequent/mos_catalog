y="822"/></Array></mxGeometry></mxCell><mxCell id="p1e51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_S3" target="p1_B2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="745" y="518"/></Array></mxGeometry></mxCell><mxCell id="p1e52" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=0.65;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_S3" target="p1_B3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1035" y="518"/></Array></mxGeometry></mxCell><mxCell id="p1e53" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_S3" target="p1_B4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1106" y="572"/><mxPoint x="1275" y="572"/></Array></mxGeometry></mxCell><mxCell id="p1e54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_B4" target="p1_B5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1e55" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_B5" target="p1_B6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1e56" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_B6" target="p1_UIP"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1e57" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_UIP" target="p1_B7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1e58" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_B7" target="p1_OUT"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="455" y="1050"/><mxPoint x="267" y="1050"/></Array></mxGeometry></mxCell><mxCell id="p1e59" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="p1_OUT" target="p1_B8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1e60" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="p1_B8" target="p1_FB"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1e61" value="локальная добавка к порядку" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=0.406;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="p1_FB" target="p1_B5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1e62" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="p1_FB" target="p1_PROP"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1e63" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="p1_FB" target="p1_EVAL"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1338" y="1226"/><mxPoint x="1125" y="1226"/></Array></mxGeometry></mxCell><mxCell id="p1e64" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="p1_PROP" target="p1_APPR2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1e65" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#e08a1e;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="p1_APPR2" target="p1_RULES"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1795" y="1300"/><mxPoint x="1795" y="993"/></Array></mxGeometry></mxCell><mxCell id="p1e66" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#e08a1e;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="p1_APPR2" target="p1_DICT"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1795" y="1300"/><mxPoint x="1795" y="501"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="Как решается: совпадает, замена, проверить, не подходит" id="p2"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1180" math="0" shadow="0"><root><mxCell id="p20"/><mxCell id="1" parent="p20"/><mxCell id="p2e11" value="Как система решает по паре «запрос ↔ позиция из базы»" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=22;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1800" height="30" as="geometry"/></mxCell><mxCell id="p2e12" value="Это шаг B4 и вердикт B6. Ни один балл на этот результат не влияет: оценка B5 только упорядочивает позиции внутри класса." style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=13;fontColor=#555555;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="20" y="38" width="1800" height="20" as="geometry"/></mxCell><mxCell id="p2_START" value="&lt;b&gt;Пара: запрос ↔ кандидат из 50&lt;/b&gt;&lt;br&gt;после B2 и B3; сравнивается каждая&lt;br&gt;характеристика, названная в запросе" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#222222;fontColor=#111111;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="560" y="70" width="460" height="85" as="geometry"/></mxCell><mxCell id="p2_D1" value="&lt;b&gt;1. Есть конфликт по названной характеристике?&lt;/b&gt;&lt;br&gt;другое сечение, ток, размер, материал, класс пожарной&lt;br&gt;безопасности; другая модель или серия; два разных&lt;br&gt;конкретных типа из словаря (розетка ≠ выключатель);&lt;br&gt;разрешённого правилом отличия недостаточно" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#444444;fontColor=#111111;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="560" y="190" width="460" height="120" as="geometry"/></mxCell><mxCell id="p2_REJ" value="&lt;b&gt;Не подходит (reject)&lt;/b&gt;&lt;br&gt;в выдачу не попадает;&lt;br&gt;ближайший по числу конфликтов виден&lt;br&gt;как диагностика с причиной" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbe4e4;strokeColor=#c43b3b;fontColor=#6b1414;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="380" height="120" as="geometry"/></mxCell><mxCell id="p2_D2" value="&lt;b&gt;2. Что-то нельзя проверить?&lt;/b&gt;&lt;br&gt;у кандидата нет характеристики; порядок сторон не подтверждён;&lt;br&gt;значение только в «прим.»; ограничение запроса не разобрано&lt;br&gt;(число с единицей или после названия величины), если то же&lt;br&gt;не записано у позиции (исключение: то же написание, с пометкой);&lt;br&gt;непроверенный состав; нет слова-предмета; слов мало" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#444444;fontColor=#111111;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="560" y="360" width="460" height="160" as="geometry"/></mxCell><mxCell id="p2_CHK" value="&lt;b&gt;Проверить (check)&lt;/b&gt;&lt;br&gt;«требует проверки»: специалист решает;&lt;br&gt;причина названа в карточке;&lt;br&gt;в таблице идёт после подтверждённых" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fdf0d4;strokeColor=#d08a1a;fontColor=#5c3500;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1100" y="360" width="400" height="160" as="geometry"/></mxCell><mxCell id="p2_D3" value="&lt;b&gt;3. Есть достаточное основание подтверждения?&lt;/b&gt;&lt;br&gt;характеристика или код модели совпали, либо замена&lt;br&gt;по правилу (цвет, «уличный», «шт», римский класс&lt;br&gt;и один бренд не в счёт); или совпал весь текст;&lt;br&gt;или допущение по типу (термометр), с пометкой" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#444444;fontColor=#111111;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="560" y="570" width="460" height="120" as="geometry"/></mxCell><mxCell id="p2_D4" value="&lt;b&gt;4. Отличие разрешено правилом?&lt;/b&gt;&lt;br&gt;например, камера 3 Мп ↔ 2 Мп при допуске ±1 ступень&lt;br&gt;правило названо в карточке (rule_id)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#444444;fontColor=#111111;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="560" y="740" width="460" height="110" as="geometry"/></mxCell><mxCell id="p2_SUB" value="&lt;b&gt;Допустимая замена (substitute)&lt;/b&gt;&lt;br&gt;«допустимо по правилу …», с исходным&lt;br&gt;и допустимым значением" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e4eefc;strokeColor=#3b6fd4;fontColor=#12315f;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1100" y="740" width="400" height="110" as="geometry"/></mxCell><mxCell id="p2_D5" value="&lt;b&gt;5. Совпало всё основное название?&lt;/b&gt;&lt;br&gt;после нормализации чисел, регистра, запятых и пробелов;&lt;br&gt;не комплект; синонимы словаря не в счёт" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#444444;fontColor=#111111;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="560" y="890" width="460" height="110" as="geometry"/></mxCell><mxCell id="p2_SAMEN" value="&lt;b&gt;Та же позиция по данным названия&lt;/b&gt;&lt;br&gt;единственное основание, при котором&lt;br&gt;система так пишет" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e3f4e8;strokeColor=#2f9e57;fontColor=#0f4a26;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1100" y="1030" width="400" height="110" as="geometry"/></mxCell><mxCell id="p2_SAME" value="&lt;b&gt;Совпадает по указанным параметрам&lt;/b&gt;&lt;br&gt;параметры запроса совпали; остальное не проверялось;&lt;br&gt;основание request_constraints; при допущении&lt;br&gt;по типу: type_assumption, с пометкой" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e3f4e8;strokeColor=#2f9e57;fontColor=#0f4a26;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="890" width="380" height="110" as="geometry"/></mxCell><mxCell id="p2_NOTE" value="&lt;b&gt;Чего это решение НЕ доказывает&lt;/b&gt;&lt;br&gt;• что позиции одна и та же вещь: «труба 25 мм» подойдёт и ПВХ, и ПНД, пока в запросе не назван материал;&lt;br&gt;• полноты разбора: числовой guard не ловит все словесные требования; нераспознанное свойство может быть потеряно;&lt;br&gt;• при допущении по типу: диапазон и точность не проверялись, действует допущение автора, не правило заказчика." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#444444;fontColor=#111111;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1030" width="1000" height="120" as="geometry"/></mxCell><mxCell id="p2_WHO" value="&lt;b&gt;Кто что задаёт&lt;/b&gt;&lt;br&gt;конфликты и допуски:&lt;br&gt;config/rules.yaml, специалист;&lt;br&gt;что считается подтверждением,&lt;br&gt;слабые признаки, лимиты:&lt;br&gt;policy в том же файле;&lt;br&gt;типы, синонимы, материалы:&lt;br&gt;config/dictionaries.yaml" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;fillColor=#fff0dc;strokeColor=#e08a1e;fontColor=#5c3500;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1560" y="80" width="320" height="260" as="geometry"/></mxCell><mxCell id="p2e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2_START" target="p2_D1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2e14" value="да" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2_D1" target="p2_REJ"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2e15" value="нет" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2_D1" target="p2_D2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2e16" value="да" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2_D2" target="p2_CHK"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2e17" value="нет" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2_D2" target="p2_D3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2e18" value="нет: одного типа мало" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2_D3" target="p2_CHK"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1200" y="630"/></Array></mxGeometry></mxCell><mxCell id="p2e19" value="да" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2_D3" target="p2_D4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2e20" value="да" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2_D4" target="p2_SUB"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2e21" value="нет" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2_D4" target="p2_D5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2e22" value="да" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2_D5" target="p2_SAMEN"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1060" y="945"/><mxPoint x="1060" y="1085"/></Array></mxGeometry></mxCell><mxCell id="p2e23" value="нет" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2_D5" target="p2_SAME"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="Сходство, соответствие и точки отказа" id="p3"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1820" pageHeight="1710" math="0" shadow="0"><root><mxCell id="p30"/><mxCell id="1" parent="p30"/><mxCell id="p3e11" value="Похожее описание и подходящее оборудование — разные проверки" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=23;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="8" width="1760" height="32" as="geometry"/></mxCell><mxCell id="p3e12" value="B2 предлагает кандидатов; B3/B4 проверяют предмет и требования. Ни BM25, ни E5 не утверждают допустимость замены." style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=14;fontColor=#444444;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30" y="42" width="1760" height="24" as="geometry"/></mxCell><mxCell id="p3e13" value="ДВА СПОСОБА НАЙТИ → ОДИН МЕХАНИЗМ ТЕХНИЧЕСКОГО РЕШЕНИЯ" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f6f9ff;strokeColor=#c9d8f5;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#2b4f8f;" vertex="1" parent="1"><mxGeometry x="20" y="78" width="1780" height="290" as="geometry"/></mxCell><mxCell id="p3_FQ" value="&lt;b&gt;Запрос и его разбор&lt;/b&gt;&lt;br&gt;какой предмет нужен;&lt;br&gt;что обязательно" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#222222;fontColor=#111111;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="230" height="110" as="geometry"/></mxCell><mxCell id="p3_LEX" value="&lt;b&gt;BM25: слова, коды, числа&lt;/b&gt;&lt;br&gt;Риск: параметры совпали,&lt;br&gt;а предметы разные." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#3b6fd4;fontColor=#12315f;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="340" y="118" width="380" height="100" as="geometry"/></mxCell><mxCell id="p3_SEM" value="&lt;b&gt;E5: близость смысла текста&lt;/b&gt;&lt;br&gt;Перефразировки и общая тема.&lt;br&gt;Не доказывает совместимость." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e3f5e8;strokeColor=#2f9e57;fontColor=#0f4a26;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="340" y="250" width="380" height="100" as="geometry"/></mxCell><mxCell id="p3_MERGE" value="&lt;b&gt;RRF: объединить предложения&lt;/b&gt;&lt;br&gt;до 100 + до 100 → до 50;&lt;br&gt;это ещё только кандидаты;&lt;br&gt;потерянного здесь B4 не вернёт" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#3b6fd4;fontColor=#12315f;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="800" y="176" width="350" height="140" as="geometry"/></mxCell><mxCell id="p3_TECH" value="&lt;b&gt;B3/B4: соответствие по данным названия&lt;/b&gt;&lt;br&gt;Предмет, модель/серия, распознанные признаки.&lt;br&gt;Совпало / разрешено правилом / конфликт / неизвестно.&lt;br&gt;За пределами названия нужны сведения специалиста." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#3b6fd4;fontColor=#12315f;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1230" y="176" width="550" height="140" as="geometry"/></mxCell><mxCell id="p3e14" value="Где логика может ломаться и что проверять: правый столбец — действия при диагностике, а не обещание готовности всех профилей." style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=14;fontColor=#444444;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="381" width="1740" height="26" as="geometry"/></mxCell><mxCell id="p3e15" value="Этап" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=16;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="421" width="240" height="24" as="geometry"/></mxCell><mxCell id="p3e16" value="Ошибка / признак" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=16;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="421" width="440" height="24" as="geometry"/></mxCell><mxCell id="p3e17" value="Как разбирать и исправлять" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=16;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="800" y="421" width="600" height="24" as="geometry"/></mxCell><mxCell id="p3e18" value="Отдельная проверка" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=16;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1440" y="421" width="340" height="24" as="geometry"/></mxCell><mxCell id="p3_PARSE" value="&lt;b&gt;A3–A5 / B1: разбор&lt;/b&gt;&lt;br&gt;Не распознано требование:&lt;br&gt;число, единица, слово, роль." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#444444;fontColor=#111111;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="456" width="240" height="146" as="geometry"/></mxCell><mxCell id="p3_PARSE_RISK" value="&lt;b&gt;Из запроса исчезло ограничение&lt;/b&gt;&lt;br&gt;100 МЛ, 16 портов, 1-кл.;&lt;br&gt;сталь трубы принята за свойство прибора;&lt;br&gt;потеряно словесное требование;&lt;br&gt;число в обозначении (KLS 300) не размер." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbe4e4;strokeColor=#c43b3b;fontColor=#6b1414;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="320" y="456" width="440" height="146" as="geometry"/></mxCell><mxCell id="p3_PARSE_ACTION" value="&lt;b&gt;Действие при ошибке&lt;/b&gt;&lt;br&gt;Сравнить исходный текст, атрибуты и остаток;&lt;br&gt;нормализовать единицы с правильным масштабом;&lt;br&gt;задать профиль: предмет, назначение, роль признака.&lt;br&gt;Сохранить evidence и словесные ограничения;&lt;br&gt;неясное обязательное требование → check." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff0dc;strokeColor=#e08a1e;fontColor=#5c3500;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="800" y="456" width="600" height="146" as="geometry"/></mxCell><mxCell id="p3_PARSE_CHECK" value="&lt;b&gt;Как увидеть результат&lt;/b&gt;&lt;br&gt;Тесты эквивалентных записей;&lt;br&gt;известный конфликт и no-data;&lt;br&gt;проверка роли признака." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#3b6fd4;fontColor=#12315f;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1440" y="456" width="340" height="146" as="geometry"/></mxCell><mxCell id="p3_RETRIEVE" value="&lt;b&gt;B2: набор кандидатов&lt;/b&gt;&lt;br&gt;Эталон не попал в top-50.&lt;br&gt;B4 его уже не оценит." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#444444;fontColor=#111111;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="622" width="240" height="146" as="geometry"/></mxCell><mxCell id="p3_RETRIEVE_RISK" value="&lt;b&gt;Не найдено или потеряно в B2&lt;/b&gt;&lt;br&gt;Другие слова, код, неверный пул;&lt;br&gt;BM25 и E5 могут потерять нужную строку.&lt;br&gt;Пустой экран не доказывает сбой B2." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbe4e4;strokeColor=#c43b3b;fontColor=#6b1414;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="320" y="622" width="440" height="146" as="geometry"/></mxCell><mxCell id="p3_RETRIEVE_ACTION" value="&lt;b&gt;Действие при ошибке&lt;/b&gt;&lt;br&gt;По trace проверить пул и ID кандидатов;&lt;br&gt;сопоставить BM25 и гибрид на одном наборе;&lt;br&gt;исправлять токены/поиск только после атрибуции.&lt;br&gt;Не отрезать допустимые замены и unknown-факты." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff0dc;strokeColor=#e08a1e;fontColor=#5c3500;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="800" y="622" width="600" height="146" as="geometry"/></mxCell><mxCell id="p3_RETRIEVE_CHECK" value="&lt;b&gt;Как увидеть результат&lt;/b&gt;&lt;br&gt;candidate_hit@50;&lt;br&gt;candidate_recall@50;&lt;br&gt;ранг эталона до matching." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#3b6fd4;fontColor=#12315f;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1440" y="622" width="340" height="146" as="geometry"/></mxCell><mxCell id="p3_MATCH" value="&lt;b&gt;B3/B4: сравнение&lt;/b&gt;&lt;br&gt;Похожие параметры&lt;br&gt;скрывают другой товар." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#444444;fontColor=#111111;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="788" width="240" height="146" as="geometry"/></mxCell><mxCell id="p3_MATCH_RISK" value="&lt;b&gt;Опасное ложное подтверждение&lt;/b&gt;&lt;br&gt;Розетка вместо выключателя;&lt;br&gt;труба вместо толщиномера;&lt;br&gt;две клавиши или другая модель." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbe4e4;strokeColor=#c43b3b;fontColor=#6b1414;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="320" y="788" width="440" height="146" as="geometry"/></mxCell><mxCell id="p3_MATCH_ACTION" value="&lt;b&gt;Действие при ошибке&lt;/b&gt;&lt;br&gt;Проверить предмет и каждое обязательное требование;&lt;br&gt;известное несовпадение → reject, не компенсация score;&lt;br&gt;неизвестное → check; замена только с правилом.&lt;br&gt;Сходство текста не является допуском специалиста." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff0dc;strokeColor=#e08a1e;fontColor=#5c3500;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="800" y="788" width="600" height="146" as="geometry"/></mxCell><mxCell id="p3_MATCH_CHECK" value="&lt;b&gt;Как увидеть результат&lt;/b&gt;&lt;br&gt;Фиксированные пары без B2;&lt;br&gt;все ложные подтверждения;&lt;br&gt;разрезы: предмет / требования." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#3b6fd4;fontColor=#12315f;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1440" y="788" width="340" height="146" as="geometry"/></mxCell><mxCell id="p3_UNCERTAINTY" value="&lt;b&gt;B4/B6: уверенность&lt;/b&gt;&lt;br&gt;Все сведения есть, но check;&lt;br&gt;конфликт назван неизвестным." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#444444;fontColor=#111111;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="954" width="240" height="146" as="geometry"/></mxCell><mxCell id="p3_UNCERTAINTY_RISK" value="&lt;b&gt;Неверная оценка неопределённости&lt;/b&gt;&lt;br&gt;Пример первого прогона: P10 → check;&lt;br&gt;иная серия → не просто «нет размера»;&lt;br&gt;состав комплекта не сверён." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbe4e4;strokeColor=#c43b3b;fontColor=#6b1414;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="320" y="954" width="440" height="146" as="geometry"/></mxCell><mxCell id="p3_UNCERTAINTY_ACTION" value="&lt;b&gt;Действие при ошибке&lt;/b&gt;&lt;br&gt;Разделить match, conflict и unknown по признакам;&lt;br&gt;извлечь качественные свойства и требуемый состав;&lt;br&gt;если данных действительно нет — запросить уточнение.&lt;br&gt;Подтверждение по типу не снимает остальных требований." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff0dc;strokeColor=#e08a1e;fontColor=#5c3500;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="800" y="954" width="600" height="146" as="geometry"/></mxCell><mxCell id="p3_UNCERTAINTY_CHECK" value="&lt;b&gt;Как увидеть результат&lt;/b&gt;&lt;br&gt;Матрица решений человека;&lt;br&gt;лишний check для допустимой пары;&lt;br&gt;check при известном конфликте." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#3b6fd4;fontColor=#12315f;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1440" y="954" width="340" height="146" as="geometry"/></mxCell><mxCell id="p3_DISPLAY" value="&lt;b&gt;B5–B7: отбор и вывод&lt;/b&gt;&lt;br&gt;Кандидат проверен,&lt;br&gt;но нужная строка не показана." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#444444;fontColor=#111111;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1120" width="240" height="146" as="geometry"/></mxCell><mxCell id="p3_DISPLAY_RISK" value="&lt;b&gt;Выдача скрыла результат или риск&lt;/b&gt;&lt;br&gt;Ранг/лимит, слабое evidence, фильтр таблицы;&lt;br&gt;ошибочная строка ниже верного top-1;&lt;br&gt;review смешан с подтверждённым found." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbe4e4;strokeColor=#c43b3b;fontColor=#6b1414;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="320" y="1120" width="440" height="146" as="geometry"/></mxCell><mxCell id="p3_DISPLAY_ACTION" value="&lt;b&gt;Действие при ошибке&lt;/b&gt;&lt;br&gt;Проследить класс → вердикт → ранг → on_screen;&lt;br&gt;считать results и table раздельно, проверять все строки;&lt;br&gt;показывать причину, исходное название и цену.&lt;br&gt;Не выдавать высокий балл за вероятность пригодности." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff0dc;strokeColor=#e08a1e;fontColor=#5c3500;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="800" y="1120" width="600" height="146" as="geometry"/></mxCell><mxCell id="p3_DISPLAY_CHECK" value="&lt;b&gt;Как увидеть результат&lt;/b&gt;&lt;br&gt;Confirmed / Display Hit@5;&lt;br&gt;состояния: empty / review / found;&lt;br&gt;число ошибок, не одна средняя." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#3b6fd4;fontColor=#12315f;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1440" y="1120" width="340" height="146" as="geometry"/></mxCell><mxCell id="p3_TEXT_EXAMPLE" value="&lt;b&gt;Похожи словами, но разные товары&lt;/b&gt;&lt;br&gt;Выключатель 250 В / 16 А ↔ розетка 250 В / 16 А.&lt;br&gt;Известный конфликт предмета → reject.&lt;br&gt;Толщиномер стальных труб ↔ стальная труба:&lt;br&gt;материал объекта измерения не делает трубу прибором.&lt;br&gt;Тип не установлен → не подтверждать по общим числам." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#444444;fontColor=#111111;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1314" width="550" height="180" as="geometry"/></mxCell><mxCell id="p3_MEANING_EXAMPLE" value="&lt;b&gt;Разные слова, одно назначение&lt;/b&gt;&lt;br&gt;Пирометр ↔ инфракрасный термометр.&lt;br&gt;Словарь или E5 помогает предложить кандидата.&lt;br&gt;Затем проверяются заданные бренд и параметры;&lt;br&gt;допустимость замены всё равно требует основания." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#444444;fontColor=#111111;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="635" y="1314" width="550" height="180" as="geometry"/></mxCell><mxCell id="p3_FORMAT_EXAMPLE" value="&lt;b&gt;Оформление или смысл требования?&lt;/b&gt;&lt;br&gt;Песок II класса: запятые не меняют товар.&lt;br&gt;L 3000 mm = L=3000 мм: это одна длина.&lt;br&gt;Сталь 1,5 мм без слова «толщина»: нужен профиль&lt;br&gt;или уточнение, а не молчаливое предположение." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#444444;fontColor=#111111;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1230" y="1314" width="550" height="180" as="geometry"/></mxCell><mxCell id="p3_SNAPSHOT" value="&lt;b&gt;Срез контрольной проверки · 4 ноября 2026&lt;/b&gt;&lt;br&gt;Контрольный набор из 20 запросов (12 с ответом, 8 без), разобранный и исправленный: все 12 эталонов среди 50 кандидатов, подтверждено 12/12, ложных строк 0, отказов 8/8.&lt;br&gt;Первый прогон до исправлений дал 5 из 12 при 8 ложных подтверждениях: цифры после исправлений это регрессия, а не независимая оценка.&lt;br&gt;Общая полнота понимания не доказана; независимая проверка описана в eval/PROTOCOL.md; границы реализации — в README и ARCHITECTURE." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#3b6fd4;fontColor=#12315f;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1530" width="1740" height="145" as="geometry"/></mxCell><mxCell id="p3e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3_FQ" target="p3_LEX"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="305" y="235"/><mxPoint x="305" y="168"/></Array></mxGeometry></mxCell><mxCell id="p3e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3_FQ" target="p3_SEM"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="305" y="235"/><mxPoint x="305" y="300"/></Array></mxGeometry></mxCell><mxCell id="p3e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3_LEX" target="p3_MERGE"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="760" y="168"/><mxPoint x="760" y="211"/></Array></mxGeometry></mxCell><mxCell id="p3e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3_SEM" target="p3_MERGE"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="760" y="300"/><mxPoint x="760" y="281"/></Array></mxGeometry></mxCell><mxCell id="p3e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3_MERGE" target="p3_TECH"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3_PARSE" target="p3_PARSE_RISK"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3_PARSE_RISK" target="p3_PARSE_ACTION"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3_PARSE_ACTION" target="p3_PARSE_CHECK"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3_RETRIEVE" target="p3_RETRIEVE_RISK"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3_RETRIEVE_RISK" target="p3_RETRIEVE_ACTION"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3e29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3_RETRIEVE_ACTION" target="p3_RETRIEVE_CHECK"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3e30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3_MATCH" target="p3_MATCH_RISK"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3e31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3_MATCH_RISK" target="p3_MATCH_ACTION"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3_MATCH_ACTION" target="p3_MATCH_CHECK"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3e33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3_UNCERTAINTY" target="p3_UNCERTAINTY_RISK"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3_UNCERTAINTY_RISK" target="p3_UNCERTAINTY_ACTION"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3e35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3_UNCERTAINTY_ACTION" target="p3_UNCERTAINTY_CHECK"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3e36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3_DISPLAY" target="p3_DISPLAY_RISK"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3e37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3_DISPLAY_RISK" target="p3_DISPLAY_ACTION"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3e38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3_DISPLAY_ACTION" target="p3_DISPLAY_CHECK"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>