<mxfile host="app.diagrams.net"><diagram name="Схема поиска" id="p1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1420" math="0" shadow="0"><root><mxCell id="p10"/><mxCell id="1" parent="p10"/><mxCell id="p1e11" value="Поиск аналогов: как запрос превращается в список позиций" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=22;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1700" height="30" as="geometry"/></mxCell><mxCell id="p1e12" value="Состояние реализованного прототипа на 4 ноября 2026. Пунктир: не реализовано, планируется." style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=13;fontColor=#555555;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="20" y="36" width="1700" height="20" as="geometry"/></mxCell><mxCell id="p1e13" value="ЗАРАНЕЕ: при изменении данных, словаря или кода извлечения (правила пересчёта не требуют)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f6f9ff;strokeColor=#c9d8f5;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#2b4f8f;" vertex="1" parent="1"><mxGeometry x="20" y="64" width="1760" height="310" as="geometry"/></mxCell><mxCell id="p1e14" value="ПРИ СТАРТЕ СЕРВИСА: один раз, секунды" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f7fbf8;strokeColor=#cfe5d6;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#2f6b46;" vertex="1" parent="1"><mxGeometry x="20" y="392" width="1760" height="140" as="geometry"/></mxCell><mxCell id="p1e15" value="НА КАЖДЫЙ ЗАПРОС: десятки миллисекунд" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#d6d6d6;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="20" y="552" width="1760" height="830" as="geometry"/></mxCell><mxCell id="p1_A1" value="&lt;b&gt;A1 Загрузка и чистка&lt;/b&gt;&lt;br&gt;лист «База позиций», проверка&lt;br&gt;структуры; оригинал названия&lt;br&gt;и цена не меняются&lt;br&gt;&lt;b&gt;▸ 2381 строка&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#3b6fd4;fontColor=#12315f;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="250" height="140" as="geometry"/></mxCell><mxCell id="p1_A2" value="&lt;b&gt;A2 Пометки&lt;/b&gt;&lt;br&gt;флаги для всех строк: услуга,&lt;br&gt;надбавка, комплект;&lt;br&gt;строки не удаляются&lt;br&gt;&lt;b&gt;▸ main 2277 · service 104&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#3b6fd4;fontColor=#12315f;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="330" y="100" width="250" height="140" as="geometry"/></mxCell><mxCell id="p1_A3" value="&lt;b&gt;A3 Нормализация&lt;/b&gt;&lt;br&gt;х x * → x; 1,5 → 1.5; вт = Вт;&lt;br&gt;кириллица в кодах;&lt;br&gt;«прим.» отдельно" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#3b6fd4;fontColor=#12315f;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="620" y="100" width="250" height="140" as="geometry"/></mxCell><mxCell id="p1e16" value="словарь" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e08a1e;strokeWidth=1.5;fontColor=#e08a1e;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="802" y="91" width="62" height="18" as="geometry"/></mxCell><mxCell id="p1_A5" value="&lt;b&gt;A5 Тип изделия&lt;/b&gt;&lt;br&gt;по словарю: сигнал, не фильтр;&lt;br&gt;общий или конкретный;&lt;br&gt;опознан у 86 % строк" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#3b6fd4;fontColor=#12315f;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="910" y="100" width="250" height="140" as="geometry"/></mxCell><mxCell id="p1e17" value="словарь" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e08a1e;strokeWidth=1.5;fontColor=#e08a1e;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1092" y="91" width="62" height="18" as="geometry"/></mxCell><mxCell id="p1_A4" value="&lt;b&gt;A4 Характеристики&lt;/b&gt;&lt;br&gt;нужен тип: «7×1.5» у кабеля&lt;br&gt;это жилы×сечение;&lt;br&gt;порядок сторон сохраняется" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#3b6fd4;fontColor=#12315f;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1200" y="100" width="250" height="140" as="geometry"/></mxCell><mxCell id="p1e18" value="словарь" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e08a1e;strokeWidth=1.5;fontColor=#e08a1e;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1382" y="91" width="62" height="18" as="geometry"/></mxCell><mxCell id="p1_A6" value="&lt;b&gt;A6 Каталог и dense-индекс&lt;/b&gt;&lt;br&gt;каталог: код; матрица эмбеддингов&lt;br&gt;E5: модель, считается здесь и&lt;br&gt;сохраняется; BM25 здесь не строится" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f1ff;gradientColor=#e3f5e8;gradientDirection=east;strokeColor=#3b6fd4;fontColor=#12315f;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1490" y="100" width="250" height="140" as="geometry"/></mxCell><mxCell id="p1_A4p" value="&lt;b&gt;A4+ Остаток через ИИ&lt;/b&gt;&lt;br&gt;что код не понял: ИИ пакетно&lt;br&gt;[не реализовано]" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f3f3f3;strokeColor=#8a8a8a;fontColor=#444444;fontSize=13;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="1200" y="268" width="250" height="88" as="geometry"/></mxCell><mxCell id="p1_APPR" value="&lt;b&gt;Утверждение человеком&lt;/b&gt;&lt;br&gt;предложение попадает в каталог&lt;br&gt;только после утверждения" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff0dc;strokeColor=#e08a1e;fontColor=#5c3500;fontSize=13;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="910" y="268" width="250" height="88" as="geometry"/></mxCell><mxCell id="p1_S1" value="&lt;b&gt;Файлы артефактов&lt;/b&gt;&lt;br&gt;каталог, индекс, модель,&lt;br&gt;правила, словарь" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#3b6fd4;fontColor=#12315f;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1490" y="428" width="250" height="90" as="geometry"/></mxCell><mxCell id="p1_S2" value="&lt;b&gt;SearchEngine.build&lt;/b&gt;&lt;br&gt;проверка манифестов:&lt;br&gt;устаревший каталог не стартует" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#3b6fd4;fontColor=#12315f;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1200" y="428" width="250" height="90" as="geometry"/></mxCell><mxCell id="p1e19" value="правила" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a35c00;strokeWidth=1.5;fontColor=#a35c00;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1382" y="419" width="62" height="18" as="geometry"/></mxCell><mxCell id="p1_S3" value="&lt;b&gt;Каталог и индексы в памяти&lt;/b&gt;&lt;br&gt;пулы main 2277 и service 104; BM25 строится по пулам&lt;br&gt;E5 только загружается и сверяется; правила и словарь" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#3b6fd4;fontColor=#12315f;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="620" y="428" width="540" height="90" as="geometry"/></mxCell><mxCell id="p1_Q" value="&lt;b&gt;Запрос&lt;/b&gt;&lt;br&gt;POST /search&lt;br&gt;до 500 символов, limit от 1 до 5" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#222222;fontColor=#111111;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="250" height="120" as="geometry"/></mxCell><mxCell id="p1_B1" value="&lt;b&gt;B1 Разбор запроса&lt;/b&gt;&lt;br&gt;общие функции A3–A5 + режим&lt;br&gt;запроса: сдвиг типа, коды, фразы;&lt;br&gt;флаги → пул main или service" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#3b6fd4;fontColor=#12315f;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="330" y="600" width="250" height="140" as="geometry"/></mxCell><mxCell id="p1e20" value="словарь" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e08a1e;strokeWidth=1.5;fontColor=#e08a1e;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="512" y="591" width="62" height="18" as="geometry"/></mxCell><mxCell id="p1_B2" value="&lt;b&gt;B2 Похожие кандидаты&lt;/b&gt;&lt;br&gt;BM25: слова и коды, до 100&lt;br&gt;E5: смысл текста, до 100&lt;br&gt;RRF: слияние, ещё не аналоги&lt;br&gt;&lt;b&gt;▸ выбранный пул → до 50&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f1ff;gradientColor=#e3f5e8;gradientDirection=east;strokeColor=#3b6fd4;fontColor=#12315f;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="620" y="600" width="250" height="140" as="geometry"/></mxCell><mxCell id="p1_B3" value="&lt;b&gt;B3 Тип: сигнал&lt;/b&gt;&lt;br&gt;неизвестный нейтрален;&lt;br&gt;общий или иной → проверка;&lt;br&gt;конкретный конфликт → B4&lt;br&gt;&lt;b&gt;▸ до 50 → до 50&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#3b6fd4;fontColor=#12315f;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="910" y="600" width="250" height="140" as="geometry"/></mxCell><mxCell id="p1e21" value="правила" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a35c00;strokeWidth=1.5;fontColor=#a35c00;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1092" y="591" width="62" height="18" as="geometry"/></mxCell><mxCell id="p1_B4" value="&lt;b&gt;B4 Техническая проверка&lt;/b&gt;&lt;br&gt;предмет, модель/серия и числа;&lt;br&gt;по распознанным признакам;&lt;br&gt;текстовый score не доказательство&lt;br&gt;&lt;b&gt;▸ до 50&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#3b6fd4;fontColor=#12315f;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1200" y="600" width="250" height="140" as="geometry"/></mxCell><mxCell id="p1e22" value="словарь" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e08a1e;strokeWidth=1.5;fontColor=#e08a1e;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1316" y="591" width="62" height="18" as="geometry"/></mxCell><mxCell id="p1e23" value="правила" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a35c00;strokeWidth=1.5;fontColor=#a35c00;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1382" y="591" width="62" height="18" as="geometry"/></mxCell><mxCell id="p1_PG" value="&lt;b&gt;Полнота разбора&lt;/b&gt;&lt;br&gt;ограничение запроса не разобрано&lt;br&gt;(число с единицей или после&lt;br&gt;названия величины) → «проверить»" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#3b6fd4;fontColor=#12315f;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="330" y="778" width="250" height="88" as="geometry"/></mxCell><mxCell id="p1_B5" value="&lt;b&gt;B5 Ранжирование&lt;/b&gt;&lt;br&gt;порядок внутри класса:&lt;br&gt;0,6 × характеристики +&lt;br&gt;0,4 × текст; не вероятность&lt;br&gt;&lt;b&gt;▸ до 50&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#3b6fd4;fontColor=#12315f;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1200" y="880" width="250" height="140" as="geometry"/></mxCell><mxCell id="p1e24" value="правила" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a35c00;strokeWidth=1.5;fontColor=#a35c00;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1382" y="871" width="62" height="18" as="geometry"/></mxCell><mxCell id="p1_B6" value="&lt;b&gt;B6 Списки и статус&lt;/b&gt;&lt;br&gt;подтверждённые → found;&lt;br&gt;иначе варианты к проверке&lt;br&gt;или «не найдено»" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#3b6fd4;fontColor=#12315f;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="910" y="880" width="250" height="140" as="geometry"/></mxCell><mxCell id="p1e25" value="правила" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a35c00;strokeWidth=1.5;fontColor=#a35c00;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1092" y="871" width="62" height="18" as="geometry"/></mxCell><mxCell id="p1_UIP" value="&lt;b&gt;Основная таблица&lt;/b&gt;&lt;br&gt;не больше limit ≤ 5:&lt;br&gt;подтверждённые, затем&lt;br&gt;«требует проверки»" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#3b6fd4;fontColor=#12315f;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="620" y="880" width="250" height="140" as="geometry"/></mxCell><mxCell id="p1e26" value="правила" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a35c00;strokeWidth=1.5;fontColor=#a35c00;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="802" y="871" width="62" height="18" as="geometry"/></mxCell><mxCell id="p1_B7" value="&lt;b&gt;B7 Объяснение&lt;/b&gt;&lt;br&gt;шаблоном, без ИИ: что совпало,&lt;br&gt;что допустимо по правилу,&lt;br&gt;чего нет, что не разобрано" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#3b6fd4;fontColor=#12315f;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="330" y="880" width="250" height="140" as="geometry"/></mxCell><mxCell id="p1_OUT" value="&lt;b&gt;Результат на экране&lt;/b&gt;&lt;br&gt;1. Есть подтверждённые: «совпадает по указанным параметрам» или «допустимая замена по правилу»;&lt;br&gt;    «та же позиция по данным названия» только если совпало всё нормализованное название.&lt;br&gt;2. Подтверждённых нет, есть слабые: «Подтверждённых подходящих позиций не найдено. Ниже варианты для проверки».&lt;br&gt;3. Ничего подходящего: «Не найдено». Ближайший отказ с причиной: диагностика, не результат.&lt;br&gt;У каждой позиции: название, цена, оценка и её состав, совпало / отличается / нет данных." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#222222;fontColor=#111111;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1090" width="910" height="190" as="geometry"/></mxCell><mxCell id="p1_B8" value="&lt;b&gt;B8 Специалист&lt;/b&gt;&lt;br&gt;подтверждает или отклоняет&lt;br&gt;пару «запрос → кандидат»&lt;br&gt;[не реализовано]" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff0dc;strokeColor=#e08a1e;fontColor=#5c3500;fontSize=13;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="1000" y="1090" width="250" height="110" as="geometry"/></mxCell><mxCell id="p1_FB" value="&lt;b&gt;Журнал подтверждений&lt;/b&gt;&lt;br&gt;запрос, кандидат, версия&lt;br&gt;каталога, да/нет, причина&lt;br&gt;[не реализовано]" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;fillColor=#f3f3f3;strokeColor=#8a8a8a;fontColor=#444444;fontSize=13;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="1290" y="1090" width="240" height="110" as="geometry"/></mxCell><mxCell id="p1_EVAL" value="&lt;b&gt;Контрольные запросы&lt;/b&gt;&lt;br&gt;новые пары становятся&lt;br&gt;regression-набором&lt;br&gt;[не реализовано]" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f3f3f3;strokeColor=#8a8a8a;fontColor=#444444;fontSize=13;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="1000" y="1250" width="250" height="100" as="geometry"/></mxCell><mxCell id="p1_PROP" value="&lt;b&gt;Очередь предложений&lt;/b&gt;&lt;br&gt;повторы → предложение&lt;br&gt;правила или синонима&lt;br&gt;[не реализовано]" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f3f3f3;strokeColor=#8a8a8a;fontColor=#444444;fontSize=13;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="1290" y="1250" width="240" height="100" as="geometry"/></mxCell><mxCell id="p1_APPR2" value="&lt;b&gt;Утверждает человек&lt;/b&gt;&lt;br&gt;новая версия файла&lt;br&gt;[не реализовано]" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff0dc;strokeColor=#e08a1e;fontColor=#5c3500;fontSize=13;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="1560" y="1250" width="190" height="100" as="geometry"/></mxCell><mxCell id="p1_DICT" value="&lt;b&gt;Словарь&lt;/b&gt;&lt;br&gt;config/dictionaries.yaml&lt;br&gt;типы, синонимы, материалы, цвета&lt;br&gt;ведёт специалист&lt;br&gt;используют: A3 A4 A5 B1 B4" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;fillColor=#fff0dc;strokeColor=#e08a1e;fontColor=#5c3500;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1830" y="410" width="250" height="130" as="geometry"/></mxCell><mxCell id="p1_RULES" value="&lt;b&gt;Правила&lt;/b&gt;&lt;br&gt;config/rules.yaml&lt;br&gt;ведёт специалист, код не меняется&lt;br&gt;сечение кабеля строго, камера&lt;br&gt;±1 ступень (допущения прототипа)&lt;br&gt;используют: B3 B4 B5 B6 таблица" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;fillColor=#fff0dc;strokeColor=#e08a1e;fontColor=#5c3500;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1830" y="860" width="250" height="190" as="geometry"/></mxCell><mxCell id="p1_DISTINCTION" value="&lt;b&gt;Два разных решения&lt;/b&gt;&lt;br&gt;B2: описание похоже —&lt;br&gt;предложить кандидата.&lt;br&gt;B4: требования подтверждены —&lt;br&gt;разрешить выдачу как подходящего.&lt;br&gt;Близость E5 не доказывает&lt;br&gt;техническую взаимозаменяемость.&lt;br&gt;Риски и действия: лист 3." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#444444;fontColor=#111111;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1830" y="575" width="250" height="240" as="geometry"/></mxCell><mxCell id="p1e27" value="Легенда" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=15;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1830" y="70" width="250" height="22" as="geometry"/></mxCell><mxCell id="p1_L0" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#3b6fd4;fontColor=#12315f;fontSize=10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1830" y="100" width="34" height="22" as="geometry"/></mxCell><mxCell id="p1e28" value="код" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=14;fontColor=#111111;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1876" y="100" width="200" height="22" as="geometry"/></mxCell><mxCell id="p1_L1" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e3f5e8;strokeColor=#2f9e57;fontColor=#0f4a26;fontSize=10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1830" y="136" width="34" height="22" as="geometry"/></mxCell><mxCell id="p1e29" value="модель (ИИ)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=14;fontColor=#111111;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1876" y="136" width="200" height="22" as="geometry"/></mxCell><mxCell id="p1_L2" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f1ff;gradientColor=#e3f5e8;gradientDirection=east;strokeColor=#3b6fd4;fontColor=#12315f;fontSize=10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1830" y="172" width="34" height="22" as="geometry"/></mxCell><mxCell id="p1e30" value="код и модель" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=14;fontColor=#111111;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1876" y="172" width="200" height="22" as="geometry"/></mxCell><mxCell id="p1_L3" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff0dc;strokeColor=#e08a1e;fontColor=#5c3500;fontSize=10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1830" y="208" width="34" height="22" as="geometry"/></mxCell><mxCell id="p1e31" value="решает человек" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=14;fontColor=#111111;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1876" y="208" width="200" height="22" as="geometry"/></mxCell><mxCell id="p1_L4" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f3f3f3;strokeColor=#8a8a8a;fontColor=#444444;fontSize=10;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="1830" y="244" width="34" height="22" as="geometry"/></mxCell><mxCell id="p1e32" value="не реализовано" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=14;fontColor=#111111;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1876" y="244" width="200" height="22" as="geometry"/></mxCell><mxCell id="p1e33" value="Метки «словарь» и «правила»&lt;br&gt;у блока: он читает этот файл.&lt;br&gt;Числа: сколько позиций остаётся&lt;br&gt;после шага (пример из замера)." style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;fontColor=#444444;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1830" y="290" width="250" height="100" as="geometry"/></mxCell><mxCell id="p1e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_A1" target="p1_A2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1e35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=1.0;exitY=0.5;exitDx=0;e